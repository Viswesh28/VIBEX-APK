+/* ===================== test6 · Liquid Glass ===================== */
+/* Glass tokens. Opaque fallbacks keep pre-blur WebViews fully usable. */
+:root {
+  --glass-surface: rgba(255, 255, 255, 0.55);
+  --glass-strong: rgba(255, 255, 255, 0.72);
