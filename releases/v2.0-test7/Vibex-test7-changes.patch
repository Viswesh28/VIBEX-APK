+  if (!r.ok) throw Error("Lyrics unavailable");
+  const hits = await r.json();
+  return hitToResult(pickLrclibHit(Array.isArray(hits) ? hits : [hits], query));
+}
+
+/* ----------------------------------------------------------------- KuGou */
+
+async function kugou({ title, artists, duration }, signal) {
