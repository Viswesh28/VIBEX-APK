+  const data = await search.json();
+  const ranked = (data.candidates || [])
+    .map((c) => ({
+      c,
+      score: Math.max(
+        ...artists.map((artist) =>
+          kugouScore(c, { title, artist, duration }),
+        ),
+      ),
+    }))
