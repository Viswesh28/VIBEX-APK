+}
+[data-theme="dark"] .aurora-bg {
+  filter: blur(56px) saturate(1.6) brightness(0.55);
+}
+.player-page[data-style="aurora"] {
+  background: var(--accent-deep);
+}
+.player-page[data-style="aurora"] > *:not(.aurora-bg) {
+  position: relative;
