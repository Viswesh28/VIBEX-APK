diff --git a/music-app/src/v2/theme.css b/music-app/src/v2/theme.css
index 71dcc4e..21b46ab 100644
--- a/music-app/src/v2/theme.css
+++ b/music-app/src/v2/theme.css
@@ -3440,3 +3440,59 @@ html[data-saver="true"] .sheet-backdrop {
   outline: 1px solid rgba(0, 0, 0, 0.12);
   outline-offset: -2px;
 }
+
+/* ---------------- Ember player (test8: warm artwork-tinted wash) ---------- */
+/* Solid, warm gradient wash built from the track artwork — no blur, so it
+   stays crisp and cheap on low-end GPUs, unlike aurora's heavy blur. */
+.ember-bg {
+  position: absolute;
+  inset: 0;
+  z-index: 0;
+  background-size: cover;
+  background-position: center;
+  background-color: #2a1608;
+  filter: saturate(1.35) brightness(0.6) sepia(0.35);
+  pointer-events: none;
+}
+.ember-bg::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(120% 90% at 50% 0%, #ff7a3d33 0%, transparent 55%),
+    linear-gradient(180deg, #ff9d5c14 0%, #1c0d0566 78%, #120804cc 100%);
+}
+[data-theme="dark"] .ember-bg {
+  filter: saturate(1.3) brightness(0.42) sepia(0.4);
+}
+.player-page[data-style="ember"] {
+  background: #2a1608;
+}
+.player-page[data-style="ember"] > *:not(.ember-bg) {
+  position: relative;
+  z-index: 1;
+}
+/* Warm solid cards over the artwork wash (no backdrop-filter by design). */
+.player-page[data-style="ember"] .player-main,
+.player-page[data-style="ember"] .player-secondary {
+  background: linear-gradient(180deg, #3a1d0ee6, #241105f2);
+  border: 1px solid #ff9d5c2e;
+  border-radius: 26px;
+  padding: 18px;
+  box-shadow: 0 18px 50px rgba(20, 8, 0, 0.55);
+}
+.player-page[data-style="ember"] .player-top {
+  color: #ffd9c2;
+  text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
+}
+.player-page[data-style="ember"] .player-top small,
+.player-page[data-style="ember"] .player-top strong {
+  color: #ffe9dd;
+}
+.player-page[data-style="ember"] .player-art {
+  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.6), 0 0 44px #ff7a3d33;
+  border-radius: 22px;
+  border: 1px solid #ffb27d59;
+  outline: 1px solid rgba(0, 0, 0, 0.25);
+  outline-offset: -2px;
+}
diff --git a/music-app/tests/test8.test.mjs b/music-app/tests/test8.test.mjs
new file mode 100644
index 0000000..5762bf4
--- /dev/null
+++ b/music-app/tests/test8.test.mjs
@@ -0,0 +1,24 @@
+// test8: "Ember" player style added alongside classic and aurora.
+import test from "node:test";
+import assert from "node:assert/strict";
+import { cleanSettings, defaults } from "../src/v2/core.js";
+
+test("default player style is still classic (no surprise retheme)", () => {
+  assert.equal(defaults.playerStyle, "classic");
+});
+
+test("cleanSettings keeps every valid player style, including ember", () => {
+  for (const style of ["classic", "aurora", "ember"])
+    assert.equal(cleanSettings({ ...defaults, playerStyle: style }).playerStyle, style);
+});
+
+test("cleanSettings rejects unknown player styles", () => {
+  assert.equal(
+    cleanSettings({ ...defaults, playerStyle: "vaporwave" }).playerStyle,
+    "classic",
+  );
+});
+
+test("legacy settings without playerStyle get the classic default", () => {
+  assert.equal(cleanSettings({ ...defaults, playerStyle: undefined }).playerStyle, "classic");
+});
